{
  "name": "recars",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "firebase": "firebase",
    "optimize:images": "npx tsx scripts/optimize-existing-images.ts --dry-run",
    "optimize:images:apply": "npx tsx scripts/optimize-existing-images.ts --execute",
    "mobile:assets": "node scripts/generate-app-assets.js",
    "mobile:sync": "cap sync",
    "mobile:build:android": "cd android && ./gradlew assembleDebug assembleRelease bundleRelease",
    "mobile:build:ios:sim": "xcodebuild -project ios/App/App.xcodeproj -scheme App -destination 'generic/platform=iOS Simulator' -configuration Debug clean build CODE_SIGNING_ALLOWED=NO CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO",
    "mobile:build:ios:archive": "mkdir -p ios/build && xcodebuild -project ios/App/App.xcodeproj -scheme App -destination 'generic/platform=iOS' -archivePath ios/build/Recars.xcarchive archive CODE_SIGNING_ALLOWED=NO CODE_SIGN_IDENTITY='' CODE_SIGNING_REQUIRED=NO"
  },
  "dependencies": {
    "@capacitor-community/apple-sign-in": "^7.1.0",
    "@supabase/supabase-js": "^2.117.3",
    "firebase": "^13.0.0",
    "lucide-react": "^1.55.0",
    "next": "16.4.3",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

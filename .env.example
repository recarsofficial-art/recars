# Recars Environment Configuration Example
# Copy to .env.local and populate with your production keys

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=Hyderabad

# Database Configuration (Supabase IPv4 Transaction Pooler)
DATABASE_URL=postgresql://postgres.kgzzobdvwryijuubyzbh:Recars%402026@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secure-random-secret-key-32-chars

# SMS / OTP Provider (Twilio / Fast2SMS / MSG91)
OTP_PROVIDER_API_KEY=
OTP_SENDER_ID=RECARS

# Payment Gateway (Razorpay Test Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloud Storage for Vehicle Photographs (AWS S3 / Cloudinary)
STORAGE_BUCKET_NAME=recars-vehicle-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Admin Portal Authentication
ADMIN_EMAIL=Recars.in@gmail.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_ALLOWED_EMAILS=Recars.in@gmail.com,admin@recars.in

# Recars Official Contact Information
NEXT_PUBLIC_CONTACT_EMAIL=Recars.in@gmail.com
NEXT_PUBLIC_CONTACT_PHONE="+91 99087 96677"
NEXT_PUBLIC_CONTACT_PHONE_RAW=9908796677

# Transactional Email Notifications (Automatic Alerts to recars.in@gmail.com)
# Supports Gmail App Passwords, SendGrid, Resend SMTP, Amazon SES, or Brevo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=recars.in@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
SMTP_FROM="Recars Notifications <recars.in@gmail.com>"
ADMIN_NOTIFICATION_EMAIL=recars.in@gmail.com

# Recars Environment Configuration Example
# Copy to .env.local and populate with your production keys

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY=Hyderabad

# Database Configuration (Optional for SQLite / PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/recars_db

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secure-random-secret-key-32-chars

# SMS / OTP Provider (Twilio / Fast2SMS / MSG91)
OTP_PROVIDER_API_KEY=
OTP_SENDER_ID=RECARS

# Payment Gateway (Razorpay Test Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloud Storage for Vehicle Photographs (AWS S3 / Cloudinary)
STORAGE_BUCKET_NAME=recars-vehicle-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Admin Portal Authentication
ADMIN_EMAIL=admin@recars.in
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_ALLOWED_EMAILS=admin@recars.in,admin2@recars.in
